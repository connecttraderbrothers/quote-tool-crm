# Copy to .env and fill in. Only VITE_* vars reach the browser — never put a
# secret here. Anything secret belongs in PocketBase's own settings or in the
# Coolify environment for the PocketBase container.

# PocketBase base URL.
#   dev:  leave blank to use the Vite proxy on the same origin
#   prod: https://api.yourdomain.co.uk
VITE_PB_URL=

# ─── Demo mode ──────────────────────────────────────────────────────────────
# You don't need to set this — `npm run demo` turns it on via .env.demo.
# Runs the app against in-memory sample data with no backend and no login.
# Ignored by production builds.
# VITE_DEMO=true

# ─── Seeding the first login (scripts/seed-admin.mjs) ───────────────────────
# Server-side only; never bundled. Used by `npm run seed:admin`.
#
# PB_URL=http://127.0.0.1:8090
# PB_SUPERUSER=you@example.com
# PB_SUPERUSER_PASSWORD=
# ADMIN_EMAIL=admin@traderbrothers.local
# ADMIN_PASSWORD=admin123          # localhost only — the script rejects this against a remote server
# COMPANY_NAME=Trader Brothers Ltd
