    "createRule": "@request.auth.id != '' && company = @request.auth.company",
    "updateRule": "@request.auth.id != '' && company = @request.auth.company",
    "deleteRule": "@request.auth.role != 'staff' && company = @request.auth.company",
    "fields": [
      { "name": "company", "type": "relation", "required": true, "collectionId": "pbc_companies01", "cascadeDelete": true, "maxSelect": 1 },
      { "name": "ref", "type": "text", "required": true, "max": 20 },
      { "name": "name", "type": "text", "required": true, "max": 160 },
      { "name": "phone", "type": "text", "max": 40 },
      { "name": "email", "type": "email" },
      { "name": "address", "type": "text", "max": 300 },
      { "name": "postcode", "type": "text", "max": 16 },
      { "name": "notes", "type": "text", "max": 4000 },
      { "name": "archived", "type": "bool" }
    ],
    "indexes": [
      "CREATE INDEX idx_customers_company ON customers (company)",
      "CREATE UNIQUE INDEX idx_customers_ref ON customers (company, ref)",
      "CREATE INDEX idx_customers_name ON customers (company, name)"
    ]
  },

  {
    "id": "pbc_projects001",
    "name": "projects",
    "type": "base",
