[
  {
    "id": "_pb_users_auth_",
    "name": "users",
    "type": "auth",
    "system": false,
    "listRule": "@request.auth.id != '' && company = @request.auth.company",
    "viewRule": "@request.auth.id != '' && company = @request.auth.company",
    "createRule": null,
    "updateRule": "id = @request.auth.id || (@request.auth.role = 'owner' && company = @request.auth.company)",
    "deleteRule": "@request.auth.role = 'owner' && company = @request.auth.company",
    "fields": [
      { "name": "full_name", "type": "text", "required": true, "max": 120 },
      { "name": "company", "type": "relation", "required": true, "collectionId": "pbc_companies01", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "role", "type": "select", "required": true, "maxSelect": 1, "values": ["owner", "admin", "staff"] },
      { "name": "phone", "type": "text", "max": 40 },
      { "name": "active", "type": "bool" }
    ],
    "indexes": ["CREATE INDEX idx_users_company ON users (company)"]
  },

  {
    "id": "pbc_companies01",
    "name": "companies",
    "type": "base",
    "listRule": "@request.auth.id != '' && id = @request.auth.company",
    "viewRule": "@request.auth.id != '' && id = @request.auth.company",
    "createRule": null,
    "updateRule": "@request.auth.role = 'owner' && id = @request.auth.company",
    "deleteRule": null,
    "fields": [
      { "name": "name", "type": "text", "required": true, "max": 160 },
      { "name": "address_line1", "type": "text", "max": 160 },
      { "name": "address_line2", "type": "text", "max": 160 },
      { "name": "phone", "type": "text", "max": 40 },
      { "name": "email", "type": "email" },
      { "name": "vat_number", "type": "text", "max": 40 },
      { "name": "vat_registered", "type": "bool" },
      { "name": "vat_rate", "type": "number", "min": 0, "max": 1 },
      { "name": "logo_url", "type": "url" },
      { "name": "bank_account_name", "type": "text", "max": 120 },
      { "name": "bank_sort_code", "type": "text", "max": 12 },
      { "name": "bank_account_number", "type": "text", "max": 20 },
      { "name": "default_deposit_percent", "type": "number", "min": 0, "max": 100 },
      { "name": "default_payment_due_days", "type": "number", "min": 0, "max": 365 }
    ]
  },

  {
    "id": "pbc_customers01",
    "name": "customers",
    "type": "base",
