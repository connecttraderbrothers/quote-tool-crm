  {
    "id": "pbc_documents01",
    "name": "documents",
    "type": "base",
    "listRule": "@request.auth.id != '' && company = @request.auth.company",
    "viewRule": "@request.auth.id != '' && company = @request.auth.company",
    "createRule": "@request.auth.id != '' && company = @request.auth.company",
    "updateRule": "@request.auth.id != '' && company = @request.auth.company",
    "deleteRule": "@request.auth.role != 'staff' && company = @request.auth.company",
    "fields": [
      { "name": "company", "type": "relation", "required": true, "collectionId": "pbc_companies01", "cascadeDelete": true, "maxSelect": 1 },
      { "name": "customer", "type": "relation", "required": true, "collectionId": "pbc_customers01", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "project", "type": "relation", "collectionId": "pbc_projects001", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "type", "type": "select", "required": true, "maxSelect": 1, "values": ["estimate", "invoice", "statement"] },
      { "name": "number", "type": "number", "required": true, "min": 1 },
      { "name": "status", "type": "select", "required": true, "maxSelect": 1, "values": ["draft", "sent", "accepted", "declined", "no_reply", "expired", "part_paid", "paid"] },

      { "name": "parent_document", "type": "relation", "collectionId": "pbc_documents01", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "is_deposit", "type": "bool" },
      { "name": "deposit_percent", "type": "number", "min": 0, "max": 100 },

      { "name": "site_address", "type": "text", "max": 300 },
      { "name": "site_postcode", "type": "text", "max": 16 },

      { "name": "remove_vat", "type": "bool" },
      { "name": "vat_rate", "type": "number", "min": 0, "max": 1 },
      { "name": "deduction", "type": "number", "min": 0 },
      { "name": "payment_due_days", "type": "number", "min": 0, "max": 365 },
      { "name": "notes", "type": "text", "max": 8000 },

      { "name": "subtotal", "type": "number", "min": 0 },
      { "name": "vat_amount", "type": "number", "min": 0 },
      { "name": "total", "type": "number", "min": 0 },
      { "name": "amount_due", "type": "number" },

      { "name": "issued_at", "type": "date" },
      { "name": "expires_at", "type": "date" },
      { "name": "sent_at", "type": "date" },
      { "name": "responded_at", "type": "date" },

      { "name": "pdf", "type": "file", "maxSelect": 1, "maxSize": 10485760, "mimeTypes": ["application/pdf"] },
      { "name": "snapshot", "type": "json", "maxSize": 2000000 },
      { "name": "public_token", "type": "text", "max": 64 },
      { "name": "created_by", "type": "relation", "collectionId": "_pb_users_auth_", "cascadeDelete": false, "maxSelect": 1 }
    ],
    "indexes": [
      "CREATE INDEX idx_documents_company ON documents (company)",
      "CREATE INDEX idx_documents_customer ON documents (customer)",
      "CREATE INDEX idx_documents_status ON documents (company, type, status)",
      "CREATE UNIQUE INDEX idx_documents_number ON documents (company, type, number)",
      "CREATE UNIQUE INDEX idx_documents_token ON documents (public_token)"
    ]
  },

